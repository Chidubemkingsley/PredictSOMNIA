# PredictSOMNIA — Somnia Shannon (50312)
# Copy to .env.local and fill in secrets. Never commit .env.local.

# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------

# WalletConnect — https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Chain
NEXT_PUBLIC_CHAIN_ID=50312
NEXT_PUBLIC_DEFAULT_CHAIN_ID=50312
NEXT_PUBLIC_SOMNIA_TESTNET_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_SOMNIA_RPC_URL=https://dream-rpc.somnia.network
NEXT_PUBLIC_SOMNIA_MAINNET_RPC_URL=https://api.infra.mainnet.somnia.network

# Contracts — Shannon primary (2026-09-04)
NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS=0x29C1a65695D8B9E23Fb7775d81a7C4792f9c5661
NEXT_PUBLIC_TRADER_REPUTATION_ADDRESS=0x580ABA453b81D68a2C7714df6096ba75DD8bDEF9
NEXT_PUBLIC_AI_ORACLE_ADDRESS=0x86a6FBDA8C959Aa724876dbF0f58aD319942b030
NEXT_PUBLIC_GASLESS_RELAYER_ADDRESS=0x384B2460d7AC08Cef74B02E4D80108aDCa4B4A12
NEXT_PUBLIC_WSOMNIA_ADDRESS=0x5C46B206aF8a2148DD8813Bd69a03634562aC300
NEXT_PUBLIC_X402_BETTING_ADDRESS=0x2C01AFeF1A0C4E01b336256DacFd1e6326DFcf80

# x402 / gasless — wallet that sponsors STT gas (server-only)
FACILITATOR_PRIVATE_KEY=
NEXT_PUBLIC_FACILITATOR_ADDRESS=

# AI resolution — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------

# Oracle agent (server-only; can reuse FACILITATOR_PRIVATE_KEY)
ORACLE_PRIVATE_KEY=
OPENAI_API_KEY=

# Site metadata
NEXT_PUBLIC_SITE_NAME=PredictSOMNIA
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Contract deploy / Hardhat — prefer contracts/.env
# PRIVATE_KEY=
# SOMNIA_TESTNET_RPC_URL=https://dream-rpc.somnia.network
# SOMNIA_API_KEY=
